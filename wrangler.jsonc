{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nakshatra-designer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
